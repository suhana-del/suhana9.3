import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.SQLException;

public class DatabaseDeleter {

    // Step-2: Define configuration constants for JDBC connection parameters
    private static final String JDBC_URL = "jdbc:mysql://localhost:3306/mydatabase";
    private static final String USERNAME = "root";
    private static final String PASSWORD = "password";

    public static void main(String[] args) {
        
        // Step-4: Define the parameterized DELETE query string with a target identifier 
        String deleteSQL = "DELETE FROM users WHERE id = ?";
        
        // Target targetId variable matching the configuration rules
        int targetId = 2;

        System.out.println("Connecting to database to execute removal operations...");

        // Step-3 & Step-5: Set up resource pipeline with try-with-resources layout
        try (Connection connection = DriverManager.getConnection(JDBC_URL, USERNAME, PASSWORD);
             PreparedStatement preparedStatement = connection.prepareStatement(deleteSQL)) {

            // Bind the integer configuration metric to the conditional query flag
            preparedStatement.setInt(1, targetId);

            // Step-6: Execute data processing metrics and collect mutation counter metrics
            int rowsAffected = preparedStatement.executeUpdate();

            // Step-7: Evaluate processing impact loops based on rowsAffected structural values
            if (rowsAffected > 0) {
                System.out.println("Row deleted successfully.");
            } else {
                System.out.println("No rows were deleted.");
            }

        } catch (SQLException e) {
            // Step-8: Safely route connection and transaction configuration anomalies
            System.err.println("Database runtime failure trapped!");
            System.err.println("Reason: " + e.getMessage());
        }
        // Step-9: Underlying Connection and PreparedStatement allocations automatically terminate here.
    }
}
